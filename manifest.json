{
  "manifest_version": 3,
  "name": "Side Float Bookmark",
  "version": "1.0",
  "description": "Floating button to add the bookmark",
  "permissions": ["activeTab", "scripting", "bookmarks"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["menu_items.json"],
      "exclude_matches": ["*://remotedesktop.google.com/*", "*://*.remotedesktop.google.com/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://remotedesktop.google.com/*", "*://*.remotedesktop.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
